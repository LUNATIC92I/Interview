# InterviewPro configuration. Copy to .env and adjust. Never commit the real .env file.

APP_NAME=InterviewPro
# production | local | testing
APP_ENV=production
# Never enable debug in production: it displays technical traces.
APP_DEBUG=false
# Public base URL without trailing slash (used in e-mails and absolute links)
APP_URL=http://localhost:8000
# Default interface language: fr | en
APP_LOCALE=fr
# 32+ random characters, used to sign tokens. Generate with: php bin/console key:generate
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=interviewpro
DB_USERNAME=interviewpro
DB_PASSWORD=
DB_SOCKET=

# Session security
# Idle timeout in minutes and absolute lifetime in hours
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# true forces the Secure cookie flag (required in production behind HTTPS)
SESSION_SECURE_COOKIE=auto

# Login throttling: attempts allowed per window (minutes)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Mail: none | log | mail | smtp
# "none" disables e-mail confirmation; "log" writes messages to storage/logs/mail.log (development)
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=InterviewPro
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls | ssl | none
MAIL_ENCRYPTION=tls

# Optional language model evaluation. Leave AI_PROVIDER empty to use the built-in rule based evaluator only.
# Supported: anthropic | openai_compatible
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# Reasoning effort for the anthropic provider: low | medium | high
AI_EFFORT=medium
# Only for openai_compatible providers
AI_BASE_URL=
AI_TIMEOUT_SECONDS=45
AI_MAX_CALLS_PER_USER_PER_DAY=40

# One time token enabling the web installer (/install) when no administrator exists yet.
# Leave empty to disable the web installer and use: php bin/console admin:create
INSTALL_TOKEN=

# Paid access (6 550 FCFA per profession by default; price, currency and free trial are set in Admin > Settings).
# PAYMENT_DRIVER=geniuspay for real payments. "sandbox" simulates the checkout locally and is refused when APP_ENV=production.
PAYMENT_DRIVER=sandbox
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
# Keys from the GeniusPay dashboard (Settings > API): pk_sandbox_/sk_sandbox_ for tests, pk_live_/sk_live_ in production.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
# Secret (whsec_...) returned once when the webhook is created, see README.
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_TIMEOUT_SECONDS=20
GENIUSPAY_PAYMENT_METHOD=
